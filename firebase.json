{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc*", "**/.*", "**/node_modules/**", "screenshots/**", "sample/**", "tests/**", "README.md", "*.zip"],
    "cleanUrls": true,
    "headers": [
      { "source": "sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] },
      { "source": "**/*.@(wasm)", "headers": [{ "key": "Content-Type", "value": "application/wasm" }] },
      { "source": "**", "headers": [{ "key": "Permissions-Policy", "value": "camera=(self), fullscreen=(self)" }] }
    ]
  }
}
